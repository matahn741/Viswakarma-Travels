# Telegram bot from @BotFather - never commit the real token.
TELEGRAM_BOT_TOKEN=1234567890:replace_with_your_bot_token
# Your chat id (number string), e.g. from @userinfobot
TELEGRAM_CHAT_ID=1234567890

# MongoDB stores admin settings and audit logs.
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/vishwakarma?retryWrites=true&w=majority
# Admin login. Use strong private values in production.
ADMIN_USER_ID=replace_with_admin_user
ADMIN_PASSWORD=replace_with_strong_password
ADMIN_SESSION_SECRET=replace_with_long_random_secret
