---
import Layout from "../layouts/Layout.astro";
import { siteMeta, bikes, serviceCoverage, publicBrandLogoPath } from "../config/site";
---

<Layout>
  <section class="text-center">
    <div class="animate-gentle-float mx-auto mb-6 flex max-w-[min(100%,20rem)] justify-center">
      <img
        src={publicBrandLogoPath}
        width="320"
        height="320"
        alt="Vishwakarma Travels — safe and spiritual journey"
        class="h-auto w-full rounded-2xl object-cover shadow-lg shadow-black/30 ring-1 ring-brand-700/50"
      />
    </div>
    <p
      class="animate-fade-up inline-flex rounded-full bg-brand-800/80 px-3 py-1 text-xs font-medium text-accent-400"
    >
      Book in minutes · Distance-based bike fares · UPI advance
    </p>
    <h1
      class="animate-fade-up mt-4 text-3xl font-extrabold tracking-tight text-white sm:text-4xl"
      style="animation-delay: 0.08s"
    >
      {siteMeta.tagline}
    </h1>
    <p
      class="animate-fade-up mx-auto mt-4 max-w-xl text-base text-brand-100/90"
      style="animation-delay: 0.15s"
    >
      {siteMeta.description}
    </p>
    <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
      <a
        href="/book"
        class="inline-flex w-full min-h-[48px] items-center justify-center rounded-xl bg-accent-500 px-6 py-3 text-base font-semibold text-brand-950 shadow-lg shadow-accent-500/20 hover:bg-accent-400 focus:outline-none focus:ring-2 focus:ring-accent-400 focus:ring-offset-2 focus:ring-offset-brand-950 sm:w-auto"
        >Book a ride</a
      >
      <a
        href={`tel:${siteMeta.phoneTel}`}
        class="inline-flex w-full min-h-[48px] items-center justify-center rounded-xl border border-brand-600 bg-brand-900/50 px-6 py-3 text-base font-semibold text-white hover:bg-brand-800 focus:outline-none focus:ring-2 focus:ring-brand-500 sm:w-auto"
        >Call {siteMeta.phoneDisplay}</a
      >
    </div>
  </section>

  <section class="mt-14" aria-labelledby="how-heading">
    <h2 id="how-heading" class="text-xl font-bold text-white">How it works</h2>
    <ol class="mt-6 space-y-4">
      <li class="flex gap-4 rounded-2xl border border-brand-800 bg-brand-900/40 p-4">
        <span
          class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-600 text-lg font-bold text-white"
          >1</span
        >
        <div>
          <p class="font-semibold text-white">Choose bike taxi or other vehicle</p>
          <p class="mt-1 text-sm text-brand-100/85">
            For bike taxi, enter pickup and drop, then type the trip distance in km. Fare is Rs 12 for the first km and
            Rs 6 per additional km.
          </p>
        </div>
      </li>
      <li class="flex gap-4 rounded-2xl border border-brand-800 bg-brand-900/40 p-4">
        <span
          class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-600 text-lg font-bold text-white"
          >2</span
        >
        <div>
          <p class="font-semibold text-white">Pay 10% advance via UPI</p>
          <p class="mt-1 text-sm text-brand-100/85">
            Pay the advance to our UPI ID or scan our QR code. Your bank app handles the transfer securely.
          </p>
        </div>
      </li>
      <li class="flex gap-4 rounded-2xl border border-brand-800 bg-brand-900/40 p-4">
        <span
          class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-600 text-lg font-bold text-white"
          >3</span
        >
        <div>
          <p class="font-semibold text-white">Confirm with payment proof</p>
          <p class="mt-1 text-sm text-brand-100/85">
            After the advance is paid, upload the screenshot. We verify it and confirm your booking.
          </p>
        </div>
      </li>
    </ol>
  </section>

  <section class="mt-14" aria-labelledby="fleet-heading">
    <h2 id="fleet-heading" class="text-xl font-bold text-white">Our vehicle options</h2>
    <p class="mt-2 text-sm text-brand-100/80">
      Currently operating in <strong>{serviceCoverage.current}</strong>. Planned expansion:
      <strong>{serviceCoverage.futureExpansion}</strong>.
    </p>
    <p class="mt-2 text-sm text-brand-100/80">
      Exact fare depends on distance and time-rates below are indicative. Edit service and vehicle list in
      <code class="rounded bg-brand-800 px-1 text-xs">src/config/site.ts</code>.
    </p>
    <ul class="mt-6 grid gap-4 sm:grid-cols-1">
      {
        bikes.map((bike) => (
          <li class="rounded-2xl border border-brand-800 bg-gradient-to-br from-brand-900/60 to-brand-950 p-5 shadow-lg">
            <h3 class="text-lg font-bold text-white">{bike.name}</h3>
            <p class="mt-2 text-sm text-brand-100/90">{bike.description}</p>
            <p class="mt-3 text-sm font-medium text-accent-400">{bike.priceNote}</p>
          </li>
        ))
      }
    </ul>
    <div class="mt-8 text-center">
      <a
        href="/book"
        class="inline-flex min-h-[48px] items-center justify-center rounded-xl bg-brand-600 px-6 py-3 text-base font-semibold text-white hover:bg-brand-500 focus:outline-none focus:ring-2 focus:ring-accent-500"
        >Book now</a
      >
    </div>
  </section>
</Layout>
