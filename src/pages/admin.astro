---
import Layout from "../layouts/Layout.astro";
import { bikes, siteMeta } from "../config/site";
import { getAdminSession, isAdminConfigured } from "../lib/adminAuth";

export const prerender = false;

const session = await getAdminSession(Astro.cookies);
const configured = isAdminConfigured();
const weekdays = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
---

<Layout title={`Admin App - ${siteMeta.name}`} hideMobileCta>
  <section id="admin-app-root" class="mx-auto max-w-3xl pb-24" data-vehicle-total={bikes.length}>
    <div class="mb-5 flex items-start justify-between gap-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent-400">Admin app</p>
        <h1 class="mt-1 text-2xl font-bold text-white sm:text-3xl">Operations</h1>
      </div>
      <div
        id="connection-pill"
        class="rounded-lg border border-brand-700 bg-brand-900/70 px-3 py-2 text-xs font-semibold text-brand-100"
      >
        Ready
      </div>
    </div>

    {
      !configured ? (
        <div class="rounded-lg border border-red-500/40 bg-red-950/50 p-4 text-sm text-red-100">
          Admin login is not configured. Add the admin environment variables and MongoDB URI.
        </div>
      ) : (
        <>
          <section
            id="login-panel"
            class={`rounded-lg border border-brand-800 bg-brand-900/70 p-5 shadow-2xl shadow-black/15 ${session ? "hidden" : ""}`}
          >
            <h2 class="text-xl font-bold text-white">Secure login</h2>
            <p class="mt-1 text-sm text-brand-100/75">Sign in to manage ride availability.</p>
            <form id="admin-login-form" class="mt-5 space-y-4">
              <p
                id="login-error"
                class="hidden rounded-lg border border-red-500/40 bg-red-950/50 px-3 py-2 text-sm text-red-100"
                role="alert"
              />
              <div>
                <label for="admin-user-id" class="block text-sm font-medium text-brand-100">User ID</label>
                <input
                  id="admin-user-id"
                  name="userId"
                  type="text"
                  autocomplete="username"
                  required
                  class="mt-1 min-h-[52px] w-full rounded-lg border border-brand-700 bg-brand-950 px-3 py-2 text-base text-white focus:border-accent-500 focus:outline-none focus:ring-1 focus:ring-accent-500"
                />
              </div>
              <div>
                <label for="admin-password" class="block text-sm font-medium text-brand-100">Password</label>
                <input
                  id="admin-password"
                  name="password"
                  type="password"
                  autocomplete="current-password"
                  required
                  class="mt-1 min-h-[52px] w-full rounded-lg border border-brand-700 bg-brand-950 px-3 py-2 text-base text-white focus:border-accent-500 focus:outline-none focus:ring-1 focus:ring-accent-500"
                />
              </div>
              <button
                id="login-submit"
                type="submit"
                class="min-h-[52px] w-full rounded-lg bg-accent-500 px-5 py-3 font-bold text-brand-950 transition-colors hover:bg-accent-400 focus:outline-none focus:ring-2 focus:ring-accent-400"
              >
                Login
              </button>
            </form>
          </section>

          <section id="admin-panel" class={`${session ? "" : "hidden"}`}>
            <div class="mb-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
              <div class="rounded-lg border border-brand-800 bg-brand-900/70 p-3">
                <p class="text-xs text-brand-100/65">Vehicles open</p>
                <p id="open-vehicle-count" class="mt-1 text-2xl font-bold text-white">-</p>
              </div>
              <div class="rounded-lg border border-brand-800 bg-brand-900/70 p-3">
                <p class="text-xs text-brand-100/65">Blocked</p>
                <p id="blocked-vehicle-count" class="mt-1 text-2xl font-bold text-white">-</p>
              </div>
              <div class="rounded-lg border border-brand-800 bg-brand-900/70 p-3">
                <p class="text-xs text-brand-100/65">Off days</p>
                <p id="closed-weekday-count" class="mt-1 text-2xl font-bold text-white">-</p>
              </div>
              <div class="rounded-lg border border-brand-800 bg-brand-900/70 p-3">
                <p class="text-xs text-brand-100/65">Dates closed</p>
                <p id="closed-date-count" class="mt-1 text-2xl font-bold text-white">-</p>
              </div>
            </div>

            <div class="mb-4 flex items-center justify-between rounded-lg border border-brand-800 bg-brand-900/70 p-4">
              <div class="min-w-0">
                <p class="text-xs text-brand-100/65">Signed in</p>
                <p id="signed-in-user" class="truncate font-semibold text-white">{session?.userId}</p>
              </div>
              <button
                id="logout-btn"
                type="button"
                class="min-h-[44px] rounded-lg border border-brand-600 px-4 py-2 text-sm font-semibold text-brand-100 hover:bg-brand-800 focus:outline-none focus:ring-2 focus:ring-accent-500"
              >
                Logout
              </button>
            </div>

            <form id="settings-form" class="space-y-4">
              <section data-admin-view="vehicles" class="admin-view rounded-lg border border-brand-800 bg-brand-900/70 p-4">
                <div class="flex items-center justify-between gap-3">
                  <div>
                    <h2 class="text-lg font-bold text-white">Vehicles</h2>
                    <p class="mt-1 text-sm text-brand-100/70">Turn booking types on or off.</p>
                  </div>
                  <button
                    type="button"
                    data-save-shortcut
                    class="min-h-[40px] rounded-lg bg-accent-500 px-4 py-2 text-sm font-bold text-brand-950"
                  >
                    Save
                  </button>
                </div>
                <div class="mt-4 space-y-3">
                  {
                    bikes.map((bike) => (
                      <label class="flex min-h-[72px] cursor-pointer items-center justify-between gap-4 rounded-lg border border-brand-700 bg-brand-950/70 p-4">
                        <span class="min-w-0">
                          <span class="block font-semibold text-white">{bike.name}</span>
                          <span class="mt-1 block text-xs text-brand-100/65">Blocked vehicles disappear from public booking.</span>
                        </span>
                        <input
                          type="checkbox"
                          name="blockedVehicleTypes"
                          value={bike.id}
                          class="h-6 w-6 rounded border-brand-600 text-accent-500 focus:ring-accent-500"
                          aria-label={`Block ${bike.name}`}
                        />
                      </label>
                    ))
                  }
                </div>
              </section>

              <section data-admin-view="week" class="admin-view hidden rounded-lg border border-brand-800 bg-brand-900/70 p-4">
                <h2 class="text-lg font-bold text-white">Weekly Schedule</h2>
                <p class="mt-1 text-sm text-brand-100/70">Choose regular closed days.</p>
                <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
                  {
                    weekdays.map((day, index) => (
                      <label class="flex min-h-[56px] cursor-pointer items-center justify-between rounded-lg border border-brand-700 bg-brand-950/70 px-4 py-3 text-sm font-semibold text-brand-100">
                        <span>{day}</span>
                        <input
                          type="checkbox"
                          name="closedWeekdays"
                          value={index}
                          class="h-5 w-5 rounded border-brand-600 text-accent-500 focus:ring-accent-500"
                          aria-label={`Close every ${day}`}
                        />
                      </label>
                    ))
                  }
                </div>
              </section>

              <section data-admin-view="dates" class="admin-view hidden rounded-lg border border-brand-800 bg-brand-900/70 p-4">
                <h2 class="text-lg font-bold text-white">Closed Dates</h2>
                <p class="mt-1 text-sm text-brand-100/70">Add one-off holidays or unavailable days.</p>
                <div class="mt-4 grid gap-3 sm:grid-cols-[1fr_auto]">
                  <input
                    id="closed-date-input"
                    type="date"
                    class="min-h-[52px] rounded-lg border border-brand-700 bg-brand-950 px-3 py-2 text-base text-white focus:border-accent-500 focus:outline-none focus:ring-1 focus:ring-accent-500"
                  />
                  <button
                    id="add-closed-date"
                    type="button"
                    class="min-h-[52px] rounded-lg border border-brand-600 px-4 py-2 text-sm font-bold text-brand-100 hover:bg-brand-800 focus:outline-none focus:ring-2 focus:ring-accent-500"
                  >
                    Add
                  </button>
                </div>
                <div id="closed-date-list" class="mt-4 flex flex-wrap gap-2"></div>
              </section>

              <section data-admin-view="logs" class="admin-view hidden rounded-lg border border-brand-800 bg-brand-900/70 p-4">
                <div class="flex items-center justify-between gap-3">
                  <div>
                    <h2 class="text-lg font-bold text-white">Activity</h2>
                    <p class="mt-1 text-sm text-brand-100/70">Recent admin actions.</p>
                  </div>
                  <button
                    id="refresh-logs"
                    type="button"
                    class="min-h-[40px] rounded-lg border border-brand-600 px-4 py-2 text-sm font-bold text-brand-100 hover:bg-brand-800 focus:outline-none focus:ring-2 focus:ring-accent-500"
                  >
                    Refresh
                  </button>
                </div>
                <div id="log-list" class="mt-4 space-y-3 text-sm text-brand-100/85"></div>
              </section>

              <p
                id="settings-status"
                class="hidden rounded-lg border border-brand-700 bg-brand-950/70 px-3 py-2 text-sm text-brand-100"
                role="status"
              ></p>

              <button
                id="save-settings"
                type="submit"
                class="min-h-[52px] w-full rounded-lg bg-accent-500 px-5 py-3 font-bold text-brand-950 transition-colors hover:bg-accent-400 focus:outline-none focus:ring-2 focus:ring-accent-400"
              >
                Save admin controls
              </button>
            </form>

            <nav
              id="admin-tabs"
              aria-label="Admin sections"
              class="fixed inset-x-0 bottom-0 z-50 border-t border-white/10 bg-brand-950/95 px-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] pt-2 backdrop-blur-xl"
            >
              <div class="mx-auto grid max-w-3xl grid-cols-4 gap-2">
                <button type="button" data-admin-tab="vehicles" class="admin-tab min-h-[48px] rounded-lg px-2 text-xs font-bold text-brand-100">
                  Fleet
                </button>
                <button type="button" data-admin-tab="week" class="admin-tab min-h-[48px] rounded-lg px-2 text-xs font-bold text-brand-100">
                  Week
                </button>
                <button type="button" data-admin-tab="dates" class="admin-tab min-h-[48px] rounded-lg px-2 text-xs font-bold text-brand-100">
                  Dates
                </button>
                <button type="button" data-admin-tab="logs" class="admin-tab min-h-[48px] rounded-lg px-2 text-xs font-bold text-brand-100">
                  Logs
                </button>
              </div>
            </nav>
          </section>
        </>
      )
    }
  </section>
</Layout>

<script>
  const loginPanel = document.getElementById("login-panel");
  const adminPanel = document.getElementById("admin-panel");
  const loginForm = document.getElementById("admin-login-form");
  const loginError = document.getElementById("login-error");
  const settingsForm = document.getElementById("settings-form");
  const settingsStatus = document.getElementById("settings-status");
  const closedDateInput = document.getElementById("closed-date-input");
  const closedDateList = document.getElementById("closed-date-list");
  const logList = document.getElementById("log-list");
  const connectionPill = document.getElementById("connection-pill");
  const appRoot = document.getElementById("admin-app-root");
  const vehicleTotal = Number(appRoot?.getAttribute("data-vehicle-total") || "0");

  let closedDates = [];

  function setConnection(text, isError = false) {
    if (!connectionPill) return;
    connectionPill.textContent = text;
    connectionPill.classList.toggle("border-red-500/40", isError);
    connectionPill.classList.toggle("bg-red-950/50", isError);
    connectionPill.classList.toggle("text-red-100", isError);
  }

  function showText(el, text, isError = false) {
    if (!el) return;
    el.textContent = text;
    el.classList.remove("hidden");
    el.classList.toggle("border-red-500/40", isError);
    el.classList.toggle("bg-red-950/50", isError);
    el.classList.toggle("text-red-100", isError);
  }

  function setActiveView(name) {
    document.querySelectorAll("[data-admin-view]").forEach((view) => {
      view.classList.toggle("hidden", view.getAttribute("data-admin-view") !== name);
    });
    document.querySelectorAll("[data-admin-tab]").forEach((tab) => {
      const active = tab.getAttribute("data-admin-tab") === name;
      tab.classList.toggle("bg-accent-500", active);
      tab.classList.toggle("text-brand-950", active);
      tab.classList.toggle("bg-brand-900", !active);
      tab.classList.toggle("text-brand-100", !active);
    });
  }

  function collectSettings() {
    const blockedVehicleTypes = Array.from(
      document.querySelectorAll('input[name="blockedVehicleTypes"]:checked'),
    ).map((input) => input.value);
    const closedWeekdays = Array.from(
      document.querySelectorAll('input[name="closedWeekdays"]:checked'),
    ).map((input) => Number(input.value));
    return { blockedVehicleTypes, closedWeekdays, closedDates };
  }

  function updateSummary() {
    const settings = collectSettings();
    const blocked = settings.blockedVehicleTypes.length;
    const setText = (id, value) => {
      const el = document.getElementById(id);
      if (el) el.textContent = String(value);
    };
    setText("open-vehicle-count", Math.max(0, vehicleTotal - blocked));
    setText("blocked-vehicle-count", blocked);
    setText("closed-weekday-count", settings.closedWeekdays.length);
    setText("closed-date-count", closedDates.length);
  }

  function renderClosedDates() {
    if (!closedDateList) return;
    closedDateList.innerHTML = "";
    if (closedDates.length === 0) {
      const empty = document.createElement("p");
      empty.className = "text-sm text-brand-100/65";
      empty.textContent = "No dates closed.";
      closedDateList.append(empty);
      updateSummary();
      return;
    }
    closedDates.forEach((date) => {
      const button = document.createElement("button");
      button.type = "button";
      button.className =
        "min-h-[40px] rounded-lg border border-brand-600 bg-brand-950 px-3 py-2 text-sm font-semibold text-brand-100 hover:bg-brand-800";
      button.textContent = `${date} x`;
      button.addEventListener("click", () => {
        closedDates = closedDates.filter((value) => value !== date);
        renderClosedDates();
      });
      closedDateList.append(button);
    });
    updateSummary();
  }

  function applySettings(settings) {
    document.querySelectorAll('input[name="blockedVehicleTypes"]').forEach((input) => {
      input.checked = settings.blockedVehicleTypes?.includes(input.value) ?? false;
    });
    document.querySelectorAll('input[name="closedWeekdays"]').forEach((input) => {
      input.checked = settings.closedWeekdays?.includes(Number(input.value)) ?? false;
    });
    closedDates = Array.isArray(settings.closedDates) ? settings.closedDates : [];
    renderClosedDates();
    updateSummary();
  }

  async function fetchJson(url, options = {}) {
    const res = await fetch(url, options);
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data.error || "Request failed.");
    return data;
  }

  async function loadSettings() {
    setConnection("Loading");
    const data = await fetchJson("/api/admin/settings");
    applySettings(data.settings);
    setConnection("Live");
  }

  async function loadLogs() {
    if (!logList) return;
    logList.textContent = "Loading...";
    try {
      const data = await fetchJson("/api/admin/logs");
      logList.innerHTML = "";
      if (!Array.isArray(data.logs) || data.logs.length === 0) {
        logList.textContent = "No admin actions logged yet.";
        return;
      }
      data.logs.forEach((log) => {
        const item = document.createElement("div");
        item.className = "rounded-lg border border-brand-800 bg-brand-950/70 p-3";
        const time = log.createdAt ? new Date(log.createdAt).toLocaleString() : "Unknown time";
        item.textContent = `${time} - ${log.userId || "admin"} - ${log.action || "action"}`;
        logList.append(item);
      });
    } catch (error) {
      logList.textContent = error instanceof Error ? error.message : "Could not load logs.";
    }
  }

  async function enterAdmin() {
    loginPanel?.classList.add("hidden");
    adminPanel?.classList.remove("hidden");
    setActiveView("vehicles");
    await loadSettings();
    await loadLogs();
  }

  loginForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!(loginForm instanceof HTMLFormElement)) return;
    loginError?.classList.add("hidden");
    const body = Object.fromEntries(new FormData(loginForm));
    try {
      await fetchJson("/api/admin/login", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      });
      await enterAdmin();
    } catch (error) {
      setConnection("Error", true);
      showText(loginError, error instanceof Error ? error.message : "Login failed.", true);
    }
  });

  document.getElementById("logout-btn")?.addEventListener("click", async () => {
    await fetch("/api/admin/logout", { method: "POST" });
    window.location.reload();
  });

  document.getElementById("add-closed-date")?.addEventListener("click", () => {
    if (!(closedDateInput instanceof HTMLInputElement) || !closedDateInput.value) return;
    if (!closedDates.includes(closedDateInput.value)) closedDates.push(closedDateInput.value);
    closedDates.sort();
    closedDateInput.value = "";
    renderClosedDates();
  });

  document.querySelectorAll('input[name="blockedVehicleTypes"], input[name="closedWeekdays"]').forEach((input) => {
    input.addEventListener("change", updateSummary);
  });

  document.querySelectorAll("[data-admin-tab]").forEach((tab) => {
    tab.addEventListener("click", () => {
      const view = tab.getAttribute("data-admin-tab");
      if (view) setActiveView(view);
    });
  });

  document.querySelectorAll("[data-save-shortcut]").forEach((button) => {
    button.addEventListener("click", () => {
      settingsForm?.requestSubmit();
    });
  });

  settingsForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    showText(settingsStatus, "Saving...");
    try {
      const data = await fetchJson("/api/admin/settings", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(collectSettings()),
      });
      applySettings(data.settings);
      showText(settingsStatus, "Admin controls saved.");
      setConnection("Live");
      await loadLogs();
    } catch (error) {
      setConnection("Error", true);
      showText(settingsStatus, error instanceof Error ? error.message : "Could not save settings.", true);
    }
  });

  document.getElementById("refresh-logs")?.addEventListener("click", () => {
    void loadLogs();
  });

  setActiveView("vehicles");
  if (!adminPanel?.classList.contains("hidden")) {
    void enterAdmin();
  }
</script>
