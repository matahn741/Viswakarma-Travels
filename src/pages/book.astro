---
import Layout from "../layouts/Layout.astro";
import {
  siteMeta,
  bikes,
  upi,
  publicUpiQrPath,
  publicBrandLogoPath,
  serviceCoverage,
} from "../config/site";
---

<Layout title={`Book a ride · ${siteMeta.name}`}>
  <div class="animate-fade-up mb-8">
    <h1 class="text-2xl font-bold text-white sm:text-3xl">Book a ride</h1>
    <p class="mt-2 text-sm text-brand-100/85">
      <strong class="text-brand-100">Bike taxi:</strong> enter trip distance after pickup and drop, review your fare, pay
      a <strong class="text-accent-400">10% advance</strong> to our UPI (ID or QR), then confirm with your payment
      screenshot.
    </p>
    <p class="mt-2 text-xs text-brand-100/75">
      Active coverage: {serviceCoverage.current}. Planned expansion: {serviceCoverage.futureExpansion}.
    </p>
  </div>

  <div
    class="mb-6 flex items-center justify-between gap-2 text-xs font-medium text-brand-100/80"
    aria-hidden="true"
    id="step-indicator"
  >
    {
      [1, 2, 3, 4].map((n) => (
        <div class="flex flex-1 flex-col items-center gap-1">
          <span
            class={`step-dot flex h-9 w-9 items-center justify-center rounded-full border-2 text-sm transition-transform duration-300 ${
              n === 1
                ? "border-accent-500 bg-brand-800 text-white"
                : "border-brand-700 bg-brand-900 text-brand-200"
            }`}
            data-step-dot={n}
          >
            {n}
          </span>
          <span class="hidden text-center sm:block">
            {n === 1 && "Vehicle"}
            {n === 2 && "Trip"}
            {n === 3 && "UPI"}
            {n === 4 && "Confirm"}
          </span>
        </div>
      ))
    }
  </div>

  <form
    id="booking-form"
    class="space-y-6"
    enctype="multipart/form-data"
    novalidate
  >
    <p
      id="form-banner"
      class="hidden rounded-xl border border-red-500/40 bg-red-950/50 px-4 py-3 text-sm text-red-100"
      role="alert"
    ></p>

    <input type="hidden" id="distanceKm" name="distanceKm" />
    <input type="hidden" id="totalFare" name="totalFare" />
    <input type="hidden" id="advanceAmount" name="advanceAmount" />

    <div
      class="step animate-fade-up space-y-4 rounded-2xl border border-brand-800 bg-brand-900/40 p-5 shadow-lg transition-shadow duration-300 hover:shadow-xl hover:shadow-black/10"
      data-step="1"
    >
      <h2 class="text-lg font-semibold text-white">1. Choose your vehicle</h2>
      <fieldset class="space-y-3">
        <legend class="sr-only">Vehicle type</legend>
        {
          bikes.map((bike) => (
            <label class="flex cursor-pointer gap-3 rounded-xl border border-brand-700 bg-brand-950/50 p-4 transition-all duration-200 has-[:checked]:border-accent-500 has-[:checked]:ring-1 has-[:checked]:ring-accent-500 has-[:checked]:shadow-md has-[:checked]:shadow-accent-500/10">
              <input
                type="radio"
                name="bikeId"
                value={bike.id}
                required
                class="mt-1 h-5 w-5 border-brand-600 text-accent-500 focus:ring-accent-500"
              />
              <span>
                <span class="block font-medium text-white">{bike.name}</span>
                <span class="mt-1 block text-sm text-brand-100/85">{bike.description}</span>
                <span class="mt-2 block text-sm font-medium text-accent-400">{bike.priceNote}</span>
              </span>
            </label>
          ))
        }
      </fieldset>
      <div class="flex justify-end pt-2">
        <button
          type="button"
          class="next-btn min-h-[48px] rounded-xl bg-brand-600 px-5 py-3 font-semibold text-white transition-colors duration-200 hover:bg-brand-500 focus:outline-none focus:ring-2 focus:ring-accent-500"
          data-next
        >
          Continue
        </button>
      </div>
    </div>

    <div
      class="step hidden animate-fade-up space-y-4 rounded-2xl border border-brand-800 bg-brand-900/40 p-5 shadow-lg transition-shadow duration-300 hover:shadow-xl hover:shadow-black/10"
      data-step="2"
    >
      <h2 class="text-lg font-semibold text-white">2. Trip details &amp; contact</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label for="date" class="block text-sm font-medium text-brand-100">Ride date</label>
          <input
            id="date"
            name="date"
            type="date"
            required
            class="mt-1 w-full min-h-[48px] rounded-xl border border-brand-700 bg-brand-950 px-3 py-2 text-white focus:border-accent-500 focus:outline-none focus:ring-1 focus:ring-accent-500"
          />
        </div>
        <div>
          <label for="time" class="block text-sm font-medium text-brand-100">Pickup time</label>
          <input
            id="time"
            name="time"
            type="time"
            required
            class="mt-1 w-full min-h-[48px] rounded-xl border border-brand-700 bg-brand-950 px-3 py-2 text-white focus:border-accent-500 focus:outline-none focus:ring-1 focus:ring-accent-500"
          />
        </div>
      </div>
      <div>
        <label for="customerName" class="block text-sm font-medium text-brand-100">Your name</label>
        <input
          id="customerName"
          name="customerName"
          type="text"
          autocomplete="name"
          required
          class="mt-1 w-full min-h-[48px] rounded-xl border border-brand-700 bg-brand-950 px-3 py-2 text-white focus:border-accent-500 focus:outline-none focus:ring-1 focus:ring-accent-500"
        />
      </div>
      <div>
        <label for="customerPhone" class="block text-sm font-medium text-brand-100">Phone number</label>
        <input
          id="customerPhone"
          name="customerPhone"
          type="tel"
          autocomplete="tel"
          inputmode="tel"
          required
          class="mt-1 w-full min-h-[48px] rounded-xl border border-brand-700 bg-brand-950 px-3 py-2 text-white focus:border-accent-500 focus:outline-none focus:ring-1 focus:ring-accent-500"
        />
      </div>
      <div>
        <label for="pickup" class="block text-sm font-medium text-brand-100">Pick-up location</label>
        <input
          id="pickup"
          name="pickup"
          type="text"
          required
          class="mt-1 w-full min-h-[48px] rounded-xl border border-brand-700 bg-brand-950 px-3 py-2 text-white focus:border-accent-500 focus:outline-none focus:ring-1 focus:ring-accent-500"
          placeholder="Area, landmark, or address"
        />
        <div class="mt-2 flex flex-wrap items-center gap-2">
          <button
            type="button"
            id="pickup-locate-btn"
            class="min-h-[42px] rounded-lg border border-brand-600 px-3 py-2 text-xs font-semibold text-brand-100 transition-colors hover:bg-brand-800 focus:outline-none focus:ring-2 focus:ring-accent-500"
          >
            Use current location
          </button>
          <span id="pickup-location-status" class="text-xs text-brand-100/70"></span>
        </div>
      </div>
      <div>
        <label for="drop" class="block text-sm font-medium text-brand-100">Drop location</label>
        <input
          id="drop"
          name="drop"
          type="text"
          required
          class="mt-1 w-full min-h-[48px] rounded-xl border border-brand-700 bg-brand-950 px-3 py-2 text-white focus:border-accent-500 focus:outline-none focus:ring-1 focus:ring-accent-500"
          placeholder="Destination area or address"
        />
        <div class="mt-2 flex flex-wrap items-center gap-2">
          <button
            type="button"
            id="drop-locate-btn"
            class="min-h-[42px] rounded-lg border border-brand-600 px-3 py-2 text-xs font-semibold text-brand-100 transition-colors hover:bg-brand-800 focus:outline-none focus:ring-2 focus:ring-accent-500"
          >
            Use current location
          </button>
          <span id="drop-location-status" class="text-xs text-brand-100/70"></span>
        </div>
      </div>

      <div class="hidden space-y-3 rounded-xl border border-accent-500/30 bg-brand-950/60 p-4" data-bike-only>
        <p class="text-sm font-medium text-white">Bike taxi fare (manual distance)</p>
        <p class="text-xs text-brand-100/80">
          After entering pickup and drop above, type the one-way trip length in kilometres. Fare: <strong
            class="text-accent-400">Rs 12</strong
          > for the first km and <strong class="text-accent-400">Rs 6</strong> for each additional km (billed in whole km
          slabs).
        </p>
        <div>
          <label for="manualDistanceKm" class="block text-sm font-medium text-brand-100">Distance (km)</label>
          <input
            id="manualDistanceKm"
            type="number"
            inputmode="decimal"
            min="0.1"
            max="999"
            step="any"
            class="mt-1 w-full min-h-[48px] rounded-xl border border-brand-700 bg-brand-950 px-3 py-2 text-white focus:border-accent-500 focus:outline-none focus:ring-1 focus:ring-accent-500"
            placeholder="e.g. 4.5"
          />
        </div>
        <button
          type="button"
          id="calc-fare-btn"
          class="w-full min-h-[48px] rounded-xl border border-accent-500/50 bg-brand-800 px-4 py-3 text-sm font-semibold text-white transition-colors hover:bg-brand-700 focus:outline-none focus:ring-2 focus:ring-accent-500 sm:w-auto"
        >
          Calculate fare
        </button>
        <p id="calc-fare-status" class="text-xs text-brand-100/75"></p>
        <div id="fare-summary" class="hidden space-y-2 rounded-xl border border-brand-700 bg-brand-900/80 p-4">
          <p class="text-xs font-semibold uppercase tracking-wide text-accent-400">Estimated fare (review before paying)</p>
          <ul class="space-y-1 text-sm text-brand-100/90">
            <li>
              <span class="text-brand-100/70">Distance:</span>
              <span id="fare-distance-read" class="ml-2 font-medium text-white"></span>
            </li>
            <li>
              <span class="text-brand-100/70">Breakdown:</span>
              <span id="fare-slabs-read" class="ml-2 font-medium text-white"></span>
            </li>
            <li class="pt-2 text-base">
              <span class="text-brand-100/70">Total fare:</span>
              <span id="fare-total-read" class="ml-2 font-bold text-accent-400"></span>
            </li>
            <li>
              <span class="text-brand-100/70">10% advance due:</span>
              <span id="fare-advance-read" class="ml-2 font-bold text-white"></span>
            </li>
          </ul>
        </div>
      </div>

      <input type="hidden" id="pickupLat" name="pickupLat" />
      <input type="hidden" id="pickupLng" name="pickupLng" />
      <input type="hidden" id="dropLat" name="dropLat" />
      <input type="hidden" id="dropLng" name="dropLng" />

      <div>
        <label for="notes" class="block text-sm font-medium text-brand-100"
          >Notes <span class="text-brand-100/60">(optional)</span></label
        >
        <textarea
          id="notes"
          name="notes"
          rows="2"
          class="mt-1 w-full rounded-xl border border-brand-700 bg-brand-950 px-3 py-2 text-white focus:border-accent-500 focus:outline-none focus:ring-1 focus:ring-accent-500"
          placeholder="Special instructions"
        ></textarea>
      </div>

      <div class="hidden flex-col gap-3 pt-2" data-enquiry-only>
        <p class="text-sm text-brand-100/85">
          Car and auto bookings are handled as requests. We will contact you with a fare quote.
        </p>
        <button
          type="button"
          id="enquiry-submit-btn"
          class="min-h-[48px] rounded-xl bg-accent-500 px-6 py-3 font-semibold text-brand-950 transition-colors hover:bg-accent-400 focus:outline-none focus:ring-2 focus:ring-accent-400"
        >
          Submit booking request
        </button>
      </div>

      <div class="flex flex-col gap-3 pt-2 sm:flex-row sm:justify-between">
        <button
          type="button"
          class="prev-btn min-h-[48px] rounded-xl border border-brand-600 bg-transparent px-5 py-3 font-semibold text-brand-100 transition-colors hover:bg-brand-800 focus:outline-none focus:ring-2 focus:ring-brand-500"
          data-prev
        >
          Back
        </button>
        <button
          type="button"
          id="continue-after-fare"
          class="next-btn min-h-[48px] rounded-xl bg-brand-600 px-5 py-3 font-semibold text-white transition-colors hover:bg-brand-500 focus:outline-none focus:ring-2 focus:ring-accent-500 disabled:cursor-not-allowed disabled:opacity-50 sm:ml-auto"
          data-next
          disabled
        >
          Continue to payment
        </button>
      </div>
    </div>

    <div
      class="step hidden animate-fade-up space-y-4 rounded-2xl border border-brand-800 bg-brand-900/40 p-5 shadow-lg transition-shadow duration-300"
      data-step="3"
    >
      <h2 class="text-lg font-semibold text-white">3. Pay UPI advance</h2>

      <div class="flex justify-center">
        <img
          src={publicBrandLogoPath}
          width="280"
          height="280"
          alt="Vishwakarma Travels"
          class="max-h-48 w-full max-w-xs rounded-2xl object-cover shadow-lg ring-1 ring-brand-700/60 sm:max-h-56"
          loading="lazy"
        />
      </div>

      <div class="rounded-xl border border-accent-500/40 bg-brand-950/70 p-4">
        <p class="text-xs font-semibold uppercase tracking-wide text-accent-400">Your fare summary</p>
        <dl class="mt-3 grid gap-2 text-sm sm:grid-cols-3">
          <div>
            <dt class="text-brand-100/70">Distance</dt>
            <dd id="pay-step-distance" class="font-semibold text-white">—</dd>
          </div>
          <div>
            <dt class="text-brand-100/70">Total fare</dt>
            <dd id="pay-step-total" class="font-semibold text-accent-400">—</dd>
          </div>
          <div>
            <dt class="text-brand-100/70">10% advance</dt>
            <dd id="pay-step-advance" class="font-semibold text-white">—</dd>
          </div>
        </dl>
      </div>

      <p class="text-sm text-brand-100/90">{upi.paymentNote}</p>
      <div class="rounded-xl border border-brand-700 bg-brand-950/80 p-4 text-center">
        <p class="text-xs font-medium uppercase tracking-wide text-brand-100/70">Pay advance to this UPI ID</p>
        <p class="mt-2 select-all break-all text-lg font-mono font-semibold text-accent-400">{upi.id}</p>
        <p class="mt-1 text-sm text-brand-100/80">Payee: {upi.payeeName}</p>
      </div>
      <div class="grid gap-3 sm:grid-cols-2">
        <a
          id="upi-pay-link"
          href="#"
          class="inline-flex min-h-[48px] items-center justify-center rounded-xl bg-accent-500 px-4 py-3 text-sm font-semibold text-brand-950 transition-colors hover:bg-accent-400 focus:outline-none focus:ring-2 focus:ring-accent-400"
        >
          Pay advance in UPI app
        </a>
        <button
          type="button"
          id="copy-upi-btn"
          class="inline-flex min-h-[48px] items-center justify-center rounded-xl border border-brand-600 bg-brand-900 px-4 py-3 text-sm font-semibold text-brand-100 transition-colors hover:bg-brand-800 focus:outline-none focus:ring-2 focus:ring-accent-500"
        >
          Copy UPI ID
        </button>
      </div>
      <p id="upi-action-status" class="text-xs text-brand-100/70"></p>
      <div class="flex justify-center">
        <img
          src={publicUpiQrPath}
          alt="Scan to pay with UPI"
          width="200"
          height="200"
          class="hidden max-h-52 max-w-full rounded-lg border border-brand-700 bg-white p-2"
          id="upi-qr-img"
          loading="lazy"
        />
      </div>
      <p class="text-xs text-brand-100/70">
        After you send the <strong class="text-brand-100">10% advance</strong> from your UPI app, continue to the next
        step and upload the payment confirmation screenshot to confirm your booking.
      </p>
      <div class="flex flex-col gap-3 pt-2 sm:flex-row sm:justify-between">
        <button
          type="button"
          class="prev-btn min-h-[48px] rounded-xl border border-brand-600 bg-transparent px-5 py-3 font-semibold text-brand-100 transition-colors hover:bg-brand-800 focus:outline-none focus:ring-2 focus:ring-brand-500"
          data-prev
        >
          Back
        </button>
        <button
          type="button"
          class="next-btn min-h-[48px] rounded-xl bg-brand-600 px-5 py-3 font-semibold text-white transition-colors hover:bg-brand-500 focus:outline-none focus:ring-2 focus:ring-accent-500 sm:ml-auto"
          data-next
        >
          I have paid the advance — continue
        </button>
      </div>
    </div>

    <div
      class="step hidden animate-fade-up space-y-4 rounded-2xl border border-brand-800 bg-brand-900/40 p-5 shadow-lg transition-shadow duration-300"
      data-step="4"
    >
      <h2 class="text-lg font-semibold text-white">4. Confirm advance &amp; booking</h2>
      <p class="text-sm text-brand-100/90">
        Upload a clear screenshot of your <strong class="text-white">UPI advance payment</strong> (JPEG, PNG, or WebP,
        max 5 MB). We confirm your ride after verifying the 10% advance.
      </p>
      <div>
        <label for="proof" class="block text-sm font-medium text-brand-100">Advance payment screenshot</label>
        <input
          id="proof"
          name="proof"
          type="file"
          accept="image/jpeg,image/png,image/webp"
          required
          class="mt-2 block w-full min-h-[48px] text-sm text-brand-100 file:mr-4 file:rounded-lg file:border-0 file:bg-brand-600 file:px-4 file:py-2 file:font-semibold file:text-white hover:file:bg-brand-500"
        />
      </div>
      <div class="flex flex-col gap-3 pt-2 sm:flex-row sm:justify-between">
        <button
          type="button"
          class="prev-btn min-h-[48px] rounded-xl border border-brand-600 bg-transparent px-5 py-3 font-semibold text-brand-100 transition-colors hover:bg-brand-800 focus:outline-none focus:ring-2 focus:ring-brand-500"
          data-prev
        >
          Back
        </button>
        <button
          type="submit"
          id="submit-btn"
          class="min-h-[48px] rounded-xl bg-accent-500 px-6 py-3 font-semibold text-brand-950 transition-colors hover:bg-accent-400 focus:outline-none focus:ring-2 focus:ring-accent-400 disabled:cursor-not-allowed disabled:opacity-60 sm:ml-auto"
        >
          Confirm booking
        </button>
      </div>
    </div>
  </form>

  <div
    id="success-panel"
    class="animate-fade-up hidden rounded-2xl border border-accent-500/40 bg-brand-900/60 p-6 text-center outline-none"
    role="status"
    tabindex="-1"
  >
    <p class="text-lg font-semibold text-accent-400">Booking received</p>
    <p class="mt-2 text-sm text-brand-100/90">
      Thank you. We have notified our team. Save your reference:
    </p>
    <p id="booking-ref" class="mt-3 select-all font-mono text-base font-bold text-white"></p>
    <a
      href="/"
      class="mt-6 inline-flex min-h-[48px] items-center justify-center rounded-xl bg-brand-600 px-6 py-3 font-semibold text-white transition-colors hover:bg-brand-500"
      >Back to home</a
    >
  </div>
</Layout>

<script>
  import "../scripts/booking-form-init.ts";
</script>
