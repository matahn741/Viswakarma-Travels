---
import Layout from "../layouts/Layout.astro";
import {
  siteMeta,
  bikes,
  upi,
  publicUpiQrPath,
  publicBrandLogoPath,
  serviceCoverage,
} from "../config/site";
---

<Layout title={`Book a ride · ${siteMeta.name}`}>
  <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
    <aside class="animate-fade-up lg:sticky lg:top-28">
      <div class="premium-card rounded-[1.75rem] p-5">
        <img
          src={publicBrandLogoPath}
          width="420"
          height="420"
          alt="Vishwakarma Travels"
          class="aspect-[4/3] w-full rounded-2xl object-cover shadow-2xl shadow-black/30"
        />
        <p class="mt-5 text-sm font-semibold text-accent-400">Book in minutes</p>
        <h1 class="mt-2 text-3xl font-black text-white sm:text-4xl">Reserve your ride</h1>
        <p class="mt-3 text-sm leading-6 text-brand-100/84">
          Bike taxi bookings calculate fare instantly. Pay a 10% UPI advance, upload payment proof, and get a booking
          reference.
        </p>
        <div class="mt-5 rounded-2xl border border-white/10 bg-brand-950/60 p-4">
          <p class="text-xs uppercase tracking-[0.18em] text-brand-100/60">Coverage</p>
          <p class="mt-2 text-sm font-semibold text-white">{serviceCoverage.current}</p>
          <p class="mt-1 text-xs text-brand-100/70">Expansion: {serviceCoverage.futureExpansion}</p>
        </div>
      </div>
    </aside>

    <section class="animate-fade-up" style="animation-delay: 0.08s">
      <div
        class="mb-6 grid grid-cols-4 gap-2 text-xs font-semibold text-brand-100/80"
        aria-hidden="true"
        id="step-indicator"
      >
        {
          [
            ["Vehicle", 1],
            ["Trip", 2],
            ["UPI", 3],
            ["Confirm", 4],
          ].map(([label, n]) => (
            <div class="rounded-2xl border border-white/10 bg-white/[0.08] p-2 text-center backdrop-blur">
              <span
                class={`step-dot mx-auto flex h-9 w-9 items-center justify-center rounded-full border-2 text-sm transition-all duration-300 ${
                  n === 1
                    ? "border-accent-500 bg-accent-500 text-brand-950 shadow-lg shadow-accent-500/20"
                    : "border-brand-700 bg-brand-900 text-brand-200"
                }`}
                data-step-dot={n}
              >
                {n}
              </span>
              <span class="mt-1 hidden sm:block">{label}</span>
            </div>
          ))
        }
      </div>

      <form id="booking-form" class="space-y-6" enctype="multipart/form-data" novalidate>
        <p
          id="form-banner"
          class="hidden rounded-2xl border border-red-500/40 bg-red-950/50 px-4 py-3 text-sm text-red-100"
          role="alert"
        ></p>

        <input type="hidden" id="distanceKm" name="distanceKm" />
        <input type="hidden" id="totalFare" name="totalFare" />
        <input type="hidden" id="advanceAmount" name="advanceAmount" />

        <div class="step premium-card space-y-4 rounded-[1.5rem] p-5 sm:p-6" data-step="1">
          <h2 class="text-xl font-black text-white">Choose your vehicle</h2>
          <fieldset class="space-y-3">
            <legend class="sr-only">Vehicle type</legend>
            {
              bikes.map((bike) => (
                <label class="group flex cursor-pointer gap-3 rounded-2xl border border-white/10 bg-brand-950/55 p-4 transition-all duration-200 hover:-translate-y-0.5 hover:border-accent-400/50 has-[:checked]:border-accent-500 has-[:checked]:bg-accent-500/10 has-[:checked]:ring-1 has-[:checked]:ring-accent-500">
                  <input
                    type="radio"
                    name="bikeId"
                    value={bike.id}
                    required
                    class="mt-1 h-5 w-5 border-brand-600 text-accent-500 focus:ring-accent-500"
                  />
                  <span>
                    <span class="block font-bold text-white">{bike.name}</span>
                    <span class="mt-1 block text-sm leading-6 text-brand-100/84">{bike.description}</span>
                    <span class="mt-2 block text-sm font-bold text-accent-400">{bike.priceNote}</span>
                  </span>
                </label>
              ))
            }
          </fieldset>
          <div class="flex justify-end pt-2">
            <button type="button" class="btn-premium next-btn min-h-[50px] rounded-xl bg-brand-600 px-5 py-3 font-bold text-white focus:outline-none focus:ring-2 focus:ring-accent-500" data-next>
              Continue
            </button>
          </div>
        </div>

        <div class="step premium-card hidden space-y-4 rounded-[1.5rem] p-5 sm:p-6" data-step="2">
          <h2 class="text-xl font-black text-white">Trip details & contact</h2>
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="date" class="block text-sm font-semibold text-brand-100">Ride date</label>
              <input id="date" name="date" type="date" required class="mt-1 w-full min-h-[50px] rounded-xl border border-white/10 bg-brand-950/80 px-3 py-2 text-white focus:border-accent-500 focus:outline-none focus:ring-1 focus:ring-accent-500" />
            </div>
            <div>
              <label for="time" class="block text-sm font-semibold text-brand-100">Pickup time</label>
              <input id="time" name="time" type="time" required class="mt-1 w-full min-h-[50px] rounded-xl border border-white/10 bg-brand-950/80 px-3 py-2 text-white focus:border-accent-500 focus:outline-none focus:ring-1 focus:ring-accent-500" />
            </div>
          </div>
          <div>
            <label for="customerName" class="block text-sm font-semibold text-brand-100">Your name</label>
            <input id="customerName" name="customerName" type="text" autocomplete="name" required class="mt-1 w-full min-h-[50px] rounded-xl border border-white/10 bg-brand-950/80 px-3 py-2 text-white focus:border-accent-500 focus:outline-none focus:ring-1 focus:ring-accent-500" />
          </div>
          <div>
            <label for="customerPhone" class="block text-sm font-semibold text-brand-100">Phone number</label>
            <input id="customerPhone" name="customerPhone" type="tel" autocomplete="tel" inputmode="tel" required class="mt-1 w-full min-h-[50px] rounded-xl border border-white/10 bg-brand-950/80 px-3 py-2 text-white focus:border-accent-500 focus:outline-none focus:ring-1 focus:ring-accent-500" />
          </div>
          <div>
            <label for="pickup" class="block text-sm font-semibold text-brand-100">Pick-up location</label>
            <input id="pickup" name="pickup" type="text" required class="mt-1 w-full min-h-[50px] rounded-xl border border-white/10 bg-brand-950/80 px-3 py-2 text-white focus:border-accent-500 focus:outline-none focus:ring-1 focus:ring-accent-500" placeholder="Area, landmark, or address" />
            <div class="mt-2 flex flex-wrap items-center gap-2">
              <button type="button" id="pickup-locate-btn" class="btn-premium min-h-[42px] rounded-lg border border-white/15 px-3 py-2 text-xs font-bold text-brand-100 hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-accent-500">Use current location</button>
              <span id="pickup-location-status" class="text-xs text-brand-100/70"></span>
            </div>
          </div>
          <div>
            <label for="drop" class="block text-sm font-semibold text-brand-100">Drop location</label>
            <input id="drop" name="drop" type="text" required class="mt-1 w-full min-h-[50px] rounded-xl border border-white/10 bg-brand-950/80 px-3 py-2 text-white focus:border-accent-500 focus:outline-none focus:ring-1 focus:ring-accent-500" placeholder="Destination area or address" />
            <div class="mt-2 flex flex-wrap items-center gap-2">
              <button type="button" id="drop-locate-btn" class="btn-premium min-h-[42px] rounded-lg border border-white/15 px-3 py-2 text-xs font-bold text-brand-100 hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-accent-500">Use current location</button>
              <span id="drop-location-status" class="text-xs text-brand-100/70"></span>
            </div>
          </div>

          <div class="hidden space-y-3 rounded-2xl border border-accent-500/30 bg-brand-950/70 p-4" data-bike-only>
            <p class="text-sm font-bold text-white">Bike taxi fare</p>
            <p class="text-xs leading-5 text-brand-100/80">
              Enter the one-way trip length in kilometres. Fare: <strong class="text-accent-400">Rs 12</strong> for the
              first km and <strong class="text-accent-400">Rs 6</strong> for each additional km.
            </p>
            <div>
              <label for="manualDistanceKm" class="block text-sm font-semibold text-brand-100">Distance (km)</label>
              <input id="manualDistanceKm" type="number" inputmode="decimal" min="0.1" max="999" step="any" class="mt-1 w-full min-h-[50px] rounded-xl border border-white/10 bg-brand-950/80 px-3 py-2 text-white focus:border-accent-500 focus:outline-none focus:ring-1 focus:ring-accent-500" placeholder="e.g. 4.5" />
            </div>
            <button type="button" id="calc-fare-btn" class="btn-premium w-full min-h-[50px] rounded-xl border border-accent-500/50 bg-brand-800 px-4 py-3 text-sm font-bold text-white focus:outline-none focus:ring-2 focus:ring-accent-500 sm:w-auto">
              Calculate fare
            </button>
            <p id="calc-fare-status" class="text-xs text-brand-100/75"></p>
            <div id="fare-summary" class="hidden space-y-2 rounded-2xl border border-white/10 bg-brand-900/80 p-4">
              <p class="text-xs font-bold uppercase tracking-[0.16em] text-accent-400">Estimated fare</p>
              <ul class="space-y-1 text-sm text-brand-100/90">
                <li><span class="text-brand-100/70">Distance:</span><span id="fare-distance-read" class="ml-2 font-bold text-white"></span></li>
                <li><span class="text-brand-100/70">Breakdown:</span><span id="fare-slabs-read" class="ml-2 font-bold text-white"></span></li>
                <li class="pt-2 text-base"><span class="text-brand-100/70">Total fare:</span><span id="fare-total-read" class="ml-2 font-black text-accent-400"></span></li>
                <li><span class="text-brand-100/70">10% advance due:</span><span id="fare-advance-read" class="ml-2 font-black text-white"></span></li>
              </ul>
            </div>
          </div>

          <input type="hidden" id="pickupLat" name="pickupLat" />
          <input type="hidden" id="pickupLng" name="pickupLng" />
          <input type="hidden" id="dropLat" name="dropLat" />
          <input type="hidden" id="dropLng" name="dropLng" />

          <div>
            <label for="notes" class="block text-sm font-semibold text-brand-100">Notes <span class="text-brand-100/60">(optional)</span></label>
            <textarea id="notes" name="notes" rows="2" class="mt-1 w-full rounded-xl border border-white/10 bg-brand-950/80 px-3 py-2 text-white focus:border-accent-500 focus:outline-none focus:ring-1 focus:ring-accent-500" placeholder="Special instructions"></textarea>
          </div>

          <div class="hidden flex-col gap-3 rounded-2xl border border-white/10 bg-white/[0.08] p-4" data-enquiry-only>
            <p class="text-sm text-brand-100/85">Car and auto bookings are handled as requests. We will contact you with a fare quote.</p>
            <button type="button" id="enquiry-submit-btn" class="btn-premium min-h-[50px] rounded-xl bg-accent-500 px-6 py-3 font-bold text-brand-950 focus:outline-none focus:ring-2 focus:ring-accent-400">
              Submit booking request
            </button>
          </div>

          <div class="flex flex-col gap-3 pt-2 sm:flex-row sm:justify-between">
            <button type="button" class="btn-premium prev-btn min-h-[50px] rounded-xl border border-white/15 bg-transparent px-5 py-3 font-bold text-brand-100 focus:outline-none focus:ring-2 focus:ring-brand-500" data-prev>
              Back
            </button>
            <button type="button" id="continue-after-fare" class="btn-premium next-btn min-h-[50px] rounded-xl bg-brand-600 px-5 py-3 font-bold text-white disabled:cursor-not-allowed disabled:opacity-50 sm:ml-auto" data-next disabled>
              Continue to payment
            </button>
          </div>
        </div>

        <div class="step premium-card hidden space-y-4 rounded-[1.5rem] p-5 sm:p-6" data-step="3">
          <h2 class="text-xl font-black text-white">Pay UPI advance</h2>
          <div class="rounded-2xl border border-accent-500/40 bg-brand-950/70 p-4">
            <p class="text-xs font-bold uppercase tracking-[0.16em] text-accent-400">Your fare summary</p>
            <dl class="mt-3 grid gap-3 text-sm sm:grid-cols-3">
              <div><dt class="text-brand-100/70">Distance</dt><dd id="pay-step-distance" class="font-bold text-white">-</dd></div>
              <div><dt class="text-brand-100/70">Total fare</dt><dd id="pay-step-total" class="font-bold text-accent-400">-</dd></div>
              <div><dt class="text-brand-100/70">10% advance</dt><dd id="pay-step-advance" class="font-bold text-white">-</dd></div>
            </dl>
          </div>
          <p class="text-sm leading-6 text-brand-100/88">{upi.paymentNote}</p>
          <div class="rounded-2xl border border-white/10 bg-brand-950/80 p-4 text-center">
            <p class="text-xs font-bold uppercase tracking-[0.16em] text-brand-100/70">Pay advance to this UPI ID</p>
            <p class="mt-2 select-all break-all font-mono text-lg font-black text-accent-400">{upi.id}</p>
            <p class="mt-1 text-sm text-brand-100/80">Payee: {upi.payeeName}</p>
          </div>
          <div class="grid gap-3 sm:grid-cols-3">
            <button type="button" id="pay-with-upi-btn" class="btn-premium inline-flex min-h-[50px] items-center justify-center rounded-xl bg-accent-500 px-4 py-3 text-sm font-bold text-brand-950 focus:outline-none focus:ring-2 focus:ring-accent-400">
              Show QR
            </button>
            <a id="upi-pay-link" href="#" class="btn-premium inline-flex min-h-[50px] items-center justify-center rounded-xl bg-accent-500 px-4 py-3 text-sm font-bold text-brand-950 focus:outline-none focus:ring-2 focus:ring-accent-400">
              Open UPI app
            </a>
            <button type="button" id="copy-upi-btn" class="btn-premium inline-flex min-h-[50px] items-center justify-center rounded-xl border border-white/15 bg-brand-900 px-4 py-3 text-sm font-bold text-brand-100 focus:outline-none focus:ring-2 focus:ring-accent-500">
              Copy UPI ID
            </button>
          </div>
          <p id="upi-action-status" class="text-xs text-brand-100/70"></p>
          <div id="upi-qr-panel" class="hidden rounded-2xl border border-white/10 bg-brand-950/70 p-4">
            <p class="text-center text-xs font-bold uppercase tracking-[0.16em] text-brand-100/70">Scan this QR in any UPI app</p>
            <div class="mt-3 flex justify-center">
              <img src={publicUpiQrPath} alt="Scan to pay with UPI" width="200" height="200" class="hidden max-h-52 max-w-full rounded-lg border border-brand-700 bg-white p-2" id="upi-qr-img" loading="lazy" />
            </div>
          </div>
          <div class="flex flex-col gap-3 pt-2 sm:flex-row sm:justify-between">
            <button type="button" class="btn-premium prev-btn min-h-[50px] rounded-xl border border-white/15 bg-transparent px-5 py-3 font-bold text-brand-100 focus:outline-none focus:ring-2 focus:ring-brand-500" data-prev>Back</button>
            <button type="button" class="btn-premium next-btn min-h-[50px] rounded-xl bg-brand-600 px-5 py-3 font-bold text-white focus:outline-none focus:ring-2 focus:ring-accent-500 sm:ml-auto" data-next>I have paid - continue</button>
          </div>
        </div>

        <div class="step premium-card hidden space-y-4 rounded-[1.5rem] p-5 sm:p-6" data-step="4">
          <h2 class="text-xl font-black text-white">Confirm advance & booking</h2>
          <p class="text-sm leading-6 text-brand-100/88">
            Upload a clear screenshot of your UPI advance payment (JPEG, PNG, or WebP, max 5 MB). We confirm your ride
            after verification.
          </p>
          <div>
            <label for="proof" class="block text-sm font-semibold text-brand-100">Advance payment screenshot</label>
            <input id="proof" name="proof" type="file" accept="image/jpeg,image/png,image/webp" required class="mt-2 block w-full min-h-[50px] text-sm text-brand-100 file:mr-4 file:rounded-lg file:border-0 file:bg-brand-600 file:px-4 file:py-2 file:font-bold file:text-white hover:file:bg-brand-500" />
          </div>
          <div class="flex flex-col gap-3 pt-2 sm:flex-row sm:justify-between">
            <button type="button" class="btn-premium prev-btn min-h-[50px] rounded-xl border border-white/15 bg-transparent px-5 py-3 font-bold text-brand-100 focus:outline-none focus:ring-2 focus:ring-brand-500" data-prev>Back</button>
            <button type="submit" id="submit-btn" class="btn-premium min-h-[50px] rounded-xl bg-accent-500 px-6 py-3 font-bold text-brand-950 disabled:cursor-not-allowed disabled:opacity-60 sm:ml-auto">
              Confirm booking
            </button>
          </div>
        </div>
      </form>

      <div id="success-panel" class="premium-card hidden rounded-[1.5rem] p-6 text-center outline-none" role="status" tabindex="-1">
        <div class="booking-success-icon mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-accent-500 text-brand-950 shadow-xl shadow-accent-500/20">
          <svg viewBox="0 0 32 32" class="h-9 w-9" fill="none" aria-hidden="true">
            <path d="M8.5 16.5l5 5 10-12" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>
        <p class="mt-5 text-2xl font-black text-white">Booking received</p>
        <p class="mt-2 text-sm text-brand-100/88">Thank you. We have notified our team. Save your reference:</p>
        <p id="booking-ref" class="mt-3 select-all rounded-xl bg-brand-950/70 px-4 py-3 font-mono text-base font-black text-accent-400"></p>
        <a href="/" class="btn-premium mt-6 inline-flex min-h-[50px] items-center justify-center rounded-xl bg-brand-600 px-6 py-3 font-bold text-white">Back to home</a>
      </div>
    </section>
  </div>
</Layout>

<script>
  import "../scripts/booking-form-init.ts";
</script>
